[Unit]
Description=Setup network interface %i

[Service]
Type=oneshot
ExecStart=/usr/bin/nodeadm-internal udev-net-manager --action add --interface %i
ExecStartPost=/usr/bin/networkctl reload
RemainAfterExit=yes
User=root
Restart=on-failure
RestartSec=1
# a stop while ENI ownership is still pending ends inactive, not failed
SuccessExitStatus=SIGTERM
