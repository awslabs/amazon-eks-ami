[Unit]
Description=Setup network interface %i
# 20 restarts per 30min before the unit lands in failed (start-limit-hit).
StartLimitIntervalSec=30min
StartLimitBurst=20

[Service]
Type=oneshot
ExecStart=/usr/bin/nodeadm-internal udev-net-manager --action add --interface %i
ExecStartPost=/usr/bin/networkctl reload
RemainAfterExit=yes
User=root
Restart=on-failure
RestartSec=5
# oneshot units have no timeout by default.
TimeoutStartSec=60
