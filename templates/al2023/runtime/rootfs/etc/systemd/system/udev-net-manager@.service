[Unit]
Description=Setup network interface %i
# Recover after EC2 outages or IAM corrections without manual reset-failed.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/nodeadm-internal udev-net-manager --action add --interface %i
ExecStartPost=/usr/bin/networkctl reload
RemainAfterExit=yes
User=root
Restart=on-failure
RestartSec=5
