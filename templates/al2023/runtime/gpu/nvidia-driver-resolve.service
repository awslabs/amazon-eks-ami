[Unit]
Description=NVIDIA driver resolve
ConditionPathExists=!/opt/nvidia/current/.driver-flavor
DefaultDependencies=no
After=local-fs.target
# nodeadm-config writes the service's environment drop-in from spec.instance.environment,
# which can pin the driver tree with NVIDIA_DRIVER_TREE.
After=nodeadm-config.service
Before=shutdown.target
Conflicts=shutdown.target
RefuseManualStart=yes
RefuseManualStop=yes

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/etc/eks/resolve-nvidia-driver.sh

[Install]
WantedBy=multi-user.target
