[Unit]
Description=NVIDIA linker cache update
# Runs ldconfig for anything that requires legacy injection paths
After=nvidia-usr-copy@lib64.service
Requires=nvidia-usr-copy@lib64.service
ConditionPathExists=/opt/nvidia/current/.driver-flavor
RefuseManualStart=yes
RefuseManualStop=yes
StartLimitBurst=5
StartLimitIntervalSec=infinity

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/sbin/ldconfig
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
