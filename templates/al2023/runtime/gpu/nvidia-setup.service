[Unit]
Description=NVIDIA setup
After=nvidia-driver-resolve.service nvidia-usr-copy@bin.service nvidia-usr-copy@lib64.service nvidia-usr-copy@share.service
Requires=nvidia-usr-copy@bin.service nvidia-usr-copy@lib64.service nvidia-usr-copy@share.service
Before=nvidia-cdi-refresh.service nvidia-persistenced.service nvidia-fabricmanager.service nvidia-gridd.service
ConditionPathExists=/opt/nvidia/current/.driver-flavor
RefuseManualStart=yes
RefuseManualStop=yes
StartLimitBurst=5
StartLimitIntervalSec=infinity

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/etc/eks/setup-nvidia.sh
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target